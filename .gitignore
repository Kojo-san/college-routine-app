# ─── Dependencies ────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js build output ────────────────────────────────────────────────────
/.next/
/out/
/build
/dist

# ─── Prisma generated client ─────────────────────────────────────────────────
/app/generated/

# ─── Environment variables ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Testing artifacts ───────────────────────────────────────────────────────
/coverage
/playwright-report
/test-results
/blob-report

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Vercel ──────────────────────────────────────────────────────────────────
.vercel

# ─── AI tooling (Claude Code, Impeccable, etc.) ──────────────────────────────
.claude/
.impeccable/

# ─── OS / System files ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── IDE files ───────────────────────────────────────────────────────────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# ─── Docker local override ───────────────────────────────────────────────────
docker-compose.override.yml

# ─── Python (scripts dans les skills) ────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# ─── Certificates ────────────────────────────────────────────────────────────
*.pem
*.key
